<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>CopyLab</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../CopyLab/LabInstallation.cs;../CopyLab/LabInstallation.Removal.cs;../CopyLab/ProductDeployment.cs;../CopyLab/WindowsSchedule.cs" LinkBase="Deployment" />
    <Reference Include="CopyProbe">
      <HintPath>$(ReferenceCoreAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireCoreAssembly" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ReferenceCoreAssembly)')" Text="Provide -p:ReferenceCoreAssembly=absolute/path/to/CopyProbe.dll" />
  </Target>
</Project>
