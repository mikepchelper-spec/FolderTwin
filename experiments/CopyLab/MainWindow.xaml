<!-- Hallmark · macroestructura: hoja de trabajo · tono: técnico sereno · color: sistema
     Pre-emit critique: P4 H4 E4 S5 R5 V4 -->
<Window x:Class="CopyLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderTwin · Laboratorio de copia"
        Width="720" Height="760" MinWidth="400" MinHeight="370"
        WindowStartupLocation="CenterScreen" Language="es-CO">
    <Window.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Detail" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24" MaxWidth="680">
            <TextBlock Text="FolderTwin" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="Laboratorio de copia" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0" />
            <TextBlock Text="Analiza un lote de tres archivos sintéticos, cópialo y comprueba la restauración en otra carpeta."
                       Style="{StaticResource Detail}" />
            <Button x:Name="OpenPreviousButton" Content="Abrir sesión _anterior" Click="OpenPreviousClick"
                    HorizontalAlignment="Left" Margin="0,0,0,8"
                    AutomationProperties.AutomationId="OpenPreviousSession" />
            <TextBlock x:Name="SessionText" Style="{StaticResource Detail}" />
            <Separator Margin="0,4,0,16" />

            <TextBlock Text="1. Origen" Style="{StaticResource SectionHeading}" />
            <TextBlock x:Name="SourceText" Text="Elige la carpeta Origen del laboratorio." Style="{StaticResource Detail}" />
            <Button x:Name="SourceButton" Content="Elegir _origen" HorizontalAlignment="Left"
                    Click="ChooseSource" AutomationProperties.AutomationId="ChooseSource" />

            <TextBlock Text="2. Destino" Style="{StaticResource SectionHeading}" Margin="0,18,0,0" />
            <TextBlock x:Name="DestinationText" Text="Elige la carpeta Destino del laboratorio." Style="{StaticResource Detail}" />
            <Button x:Name="DestinationButton" Content="Elegir _destino" HorizontalAlignment="Left"
                    Click="ChooseDestination" AutomationProperties.AutomationId="ChooseDestination" />
            <Separator Margin="0,18,0,14" />

            <TextBlock Text="3. Revisar, copiar y restaurar" Style="{StaticResource SectionHeading}" />
            <Button x:Name="AnalyzeButton" Content="_Analizar carpetas" Click="AnalyzeClick"
                    HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="False"
                    AutomationProperties.AutomationId="Analyze" />
            <TextBlock x:Name="PreviewText" Text="Analiza las carpetas para revisar qué se copiará."
                       Style="{StaticResource Detail}" Margin="0,8,0,0"
                       AutomationProperties.AutomationId="LabPreview" />
            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="CopyButton" Content="_Copiar y verificar" Click="CopyClick"
                        Margin="0,0,8,8" IsEnabled="False" AutomationProperties.AutomationId="Copy" />
                <Button x:Name="RestoreButton" Content="_Restaurar y verificar" Click="RestoreClick"
                        Margin="0,0,0,8" IsEnabled="False" AutomationProperties.AutomationId="Restore" />
                <Button x:Name="VerifyButton" Content="_Verificar respaldo" Click="VerifyClick"
                        Margin="8,0,0,8" IsEnabled="False" AutomationProperties.AutomationId="VerifyBackup" />
                <Button x:Name="CancelCopyButton" Content="_Cancelar copia" Click="CancelCopyClick"
                        Margin="8,0,0,8" Visibility="Collapsed" AutomationProperties.AutomationId="CancelCopy" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Text="Selecciona las dos carpetas para empezar."
                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,4"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="LabStatus" />
            <ListBox x:Name="ResultsList" MaxHeight="140" Margin="0,8,0,0" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="BatchResults">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Expander Header="Historial de intentos" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="HistoryStatus" Text="Aún no hay intentos registrados."
                               Style="{StaticResource Detail}" AutomationProperties.LiveSetting="Polite" />
                    <ItemsControl x:Name="HistoryList" AutomationProperties.AutomationId="AttemptHistory">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4,0,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Window>
