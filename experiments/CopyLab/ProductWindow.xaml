<!-- Hallmark · workbench de escritorio · tono funcional · tema del sistema WPF
     Pre-emit critique: P4 H5 E4 S5 R5 V4 -->
<Window x:Class="CopyLab.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderTwin · Trabajos" Width="1040" Height="740" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterScreen" Language="es-CO" Icon="Assets/FolderTwin.ico">
    <Window.Resources>
        <Style x:Key="NamedDateChoice" TargetType="ComboBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="FolderTwin" FontWeight="SemiBold" />
            <TextBlock Text="Trabajos" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"
                       AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="Vista previa de la v1. Usa carpetas desechables con datos de prueba."
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid x:Name="JobListPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,12">
                    <Button x:Name="NewJobButton" Content="_Nuevo trabajo" Click="NewJobClick" Margin="0,0,8,4" />
                    <Button x:Name="RefreshJobsButton" Content="Act_ualizar" Click="RefreshJobsClick" Margin="0,0,8,4" />
                    <Button x:Name="ImportConfigurationButton" Content="_Importar configuración" Click="ImportConfigurationClick" Margin="0,0,8,4" />
                    <Button x:Name="ProductTrayButton" Content="Minimizar a _bandeja" Click="ProductTrayClick" Margin="0,0,8,4" />
                    <Button x:Name="LegacyRecoveryButton" Content="Respaldos de _alfa" Click="LegacyRecoveryClick" Margin="0,0,8,4"
                            ToolTip="Abre las herramientas compatibles para recuperar respaldos anteriores de laboratorio. No convierte ni adopta sus datos." />
                    <Button x:Name="ManageApplicationButton" Content="A_plicación" Click="ManageApplicationClick" Margin="0,0,8,4" />
                    <Button x:Name="ResumeRegistrationButton" Content="_Reanudar registro" Click="ResumeRegistrationClick"
                            IsEnabled="False" Margin="0,0,8,4" />
                </WrapPanel>
                <TextBlock x:Name="EmptyJobsText" Grid.Row="1" Text="Crea un trabajo para guardar su origen, destino y modo."
                           TextWrapping="Wrap" Margin="0,4,0,12" />
                <Grid x:Name="JobWorkspace" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="0" />
                        <RowDefinition Height="0" />
                    </Grid.RowDefinitions>
                <ListBox x:Name="JobList" SelectionChanged="JobSelected"
                         AutomationProperties.Name="Trabajos guardados y registros pendientes"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Detail}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer x:Name="JobDetailsScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="SelectedJobTitle" Text="Selecciona un trabajo" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                        <StackPanel x:Name="SelectedJobDetails" Visibility="Collapsed">
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="BackupJobButton" Content="_Respaldar ahora" Click="BackupJobClick" IsEnabled="False" Margin="0,0,8,4" />
                            <Button x:Name="RecoverJobButton" Content="Re_cuperar archivos" Click="RecoverJobClick" IsEnabled="False" Margin="0,0,8,4" />
                            <Button x:Name="ExportConfigurationButton" Content="_Exportar configuración" Click="ExportConfigurationClick" IsEnabled="False" Margin="0,0,8,4" />
                        </WrapPanel>
                        <TextBlock x:Name="RuntimeStatusText" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <TextBlock x:Name="ScheduleStatusText" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="SpaceStatusText" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <Expander Header="Carpetas del trabajo" Margin="0,4,0,4"><TextBlock x:Name="SelectedJobText" TextWrapping="Wrap" /></Expander>
                        <TextBlock Text="La pausa y la cancelación se atienden entre archivos o pasos recuperables. Puedes cerrar la ventana mientras el ejecutor sigue trabajando."
                                   TextWrapping="Wrap" Margin="0,4,0,4" />
                        <Expander Header="Historial e incidencias" Margin="0,4,0,4">
                            <ListBox x:Name="RunHistoryList" MaxHeight="180" AutomationProperties.Name="Historial del trabajo seleccionado">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                        <Expander x:Name="PendingVersionPanel" Header="Resolver un plan de versionado pendiente" Visibility="Collapsed" Margin="0,4,0,4">
                            <StackPanel>
                                <TextBlock Text="Si el origen cambió y no puedes completar el plan anterior, revísalo antes de permitir un análisis nuevo. Se conservan sus datos parciales; no contará como respaldo correcto." TextWrapping="Wrap" />
                                <Button x:Name="ReviewPendingButton" Content="Revisar plan pendiente" Click="ReviewPendingClick" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                <TextBlock x:Name="PendingReviewText" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                                <CheckBox x:Name="AcceptPendingPlan" Content="Conservar el plan incompleto y permitir uno nuevo" Checked="PendingChoiceChanged" Unchecked="PendingChoiceChanged" Margin="0,8,0,0" />
                                <Button x:Name="ApplyPendingButton" Content="Conservar plan anterior" Click="ApplyPendingClick" HorizontalAlignment="Left" IsEnabled="False" Margin="0,8,0,0" />
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="JobSettingsPanel" Header="Editar trabajo y horario" Margin="0,4,0,4" IsEnabled="False">
                            <StackPanel>
                                <Label Content="_Nombre" Target="{Binding ElementName=EditJobName}" />
                                <TextBox x:Name="EditJobName" MaxLength="100" AutomationProperties.Name="Nuevo nombre del trabajo" />
                                <Label Content="Hora _diaria (vacía para ejecutar a demanda)" Target="{Binding ElementName=EditDailyTime}" />
                                <TextBox x:Name="EditDailyTime" MaxLength="5" Width="92" HorizontalAlignment="Left" AutomationProperties.Name="Nueva hora diaria en formato HH:mm" />
                                <CheckBox x:Name="EditEnabled" Content="Trabajo _habilitado" Margin="0,8,0,4" />
                                <CheckBox x:Name="EditRetired" Content="Retirar trabajo; conservar datos y recuperación" Margin="0,0,0,8" />
                                <TextBlock Text="Retirar desactiva el horario y los nuevos respaldos. Los datos siguen disponibles para recuperar. Si un plan ya no puede completarse con el origen actual, conserva este trabajo retirado y crea otro con un destino nuevo. No se trasladan ni eliminan sus datos parciales y no se libera su espacio. Para reactivarlo, desmarca Retirar y vuelve a habilitarlo; su diario seguirá pendiente. Para cambiar las carpetas o el modo, crea otro trabajo."
                                           TextWrapping="Wrap" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="ReviewImportedSourceButton" Content="Revisar origen importado" Click="ReviewImportedSourceClick" IsEnabled="False" Margin="0,0,8,4" />
                                    <Button x:Name="SaveSettingsButton" Content="Guardar _cambios" Click="SaveSettingsClick" Margin="0,0,8,4" />
                                    <Button x:Name="ApplyScheduleButton" Content="Reparar _horario" Click="ApplyScheduleClick" Margin="0,0,8,4" />
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="ProductRetentionPanel" Header="Retención manual y cuarentena" Expanded="ProductRetentionExpanded" IsEnabled="False" Margin="0,4,0,4">
                            <StackPanel>
                                <TextBlock Text="Revisa qué fechas expirarán antes de mover objetos. La cuarentena conserva los datos y todavía no libera espacio. La política usa calendario UTC." TextWrapping="Wrap" />
                                <WrapPanel Margin="0,8,0,8">
                                    <StackPanel Margin="0,0,8,4"><Label Content="Días" Target="{Binding ElementName=ProductRetentionDays}" /><TextBox x:Name="ProductRetentionDays" Text="30" Width="60" TextChanged="ProductRetentionPolicyChanged" AutomationProperties.Name="Días de retención diaria" /></StackPanel>
                                    <StackPanel Margin="0,0,8,4"><Label Content="Semanas" Target="{Binding ElementName=ProductRetentionWeeks}" /><TextBox x:Name="ProductRetentionWeeks" Text="8" Width="60" TextChanged="ProductRetentionPolicyChanged" AutomationProperties.Name="Semanas de retención semanal" /></StackPanel>
                                    <StackPanel Margin="0,0,8,4"><Label Content="Meses" Target="{Binding ElementName=ProductRetentionMonths}" /><TextBox x:Name="ProductRetentionMonths" Text="12" Width="60" TextChanged="ProductRetentionPolicyChanged" AutomationProperties.Name="Meses de retención mensual" /></StackPanel>
                                    <StackPanel Margin="0,0,8,4"><Label Content="Gracia (días)" Target="{Binding ElementName=ProductRetentionGrace}" /><TextBox x:Name="ProductRetentionGrace" Text="7" Width="60" TextChanged="ProductRetentionPolicyChanged" AutomationProperties.Name="Días de gracia antes de purgar" /></StackPanel>
                                </WrapPanel>
                                <Button x:Name="PreviewProductRetentionButton" Content="Revisar _retención" Click="PreviewProductRetentionClick" HorizontalAlignment="Left" />
                                <TextBlock x:Name="ProductRetentionText" TextWrapping="Wrap" Margin="0,8,0,8" AutomationProperties.LiveSetting="Polite" />
                                <CheckBox x:Name="AcceptProductRetention" Content="He revisado las fechas que expirarán" Checked="ProductRetentionChoiceChanged" Unchecked="ProductRetentionChoiceChanged" Margin="0,0,0,8" />
                                <Button x:Name="ApplyProductRetentionButton" Content="Mover a _cuarentena" Click="ApplyProductRetentionClick" IsEnabled="False" HorizontalAlignment="Left" />
                                <ComboBox x:Name="ProductRetentionChoice" DisplayMemberPath="Label" ItemContainerStyle="{StaticResource NamedDateChoice}" SelectionChanged="ProductRetentionChoiceChanged" AutomationProperties.Name="Historial de cuarentenas del trabajo" Margin="0,8,0,8" />
                                <WrapPanel>
                                    <Button x:Name="ResumeProductRetentionButton" Content="Reanudar movimientos" Click="ResumeProductRetentionClick" IsEnabled="False" Margin="0,0,8,4" />
                                    <Button x:Name="UndoProductRetentionButton" Content="Deshacer cuarentena" Click="UndoProductRetentionClick" IsEnabled="False" Margin="0,0,8,4" />
                                </WrapPanel>
                                <CheckBox x:Name="AcceptProductPurge" Content="Entiendo que la purga borra datos y no se puede deshacer" Checked="ProductRetentionChoiceChanged" Unchecked="ProductRetentionChoiceChanged" Margin="0,8,0,8" />
                                <Button x:Name="PurgeProductRetentionButton" Content="Purgar tras el plazo de gracia" Click="PurgeProductRetentionClick" IsEnabled="False" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Expander>
                        <StackPanel x:Name="MirrorReviewPanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock x:Name="MirrorReviewText" TextWrapping="Wrap" />
                            <CheckBox x:Name="AcceptEmptySource" Content="He revisado que el origen esté vacío" Margin="0,8,0,0" />
                            <CheckBox x:Name="AcceptMassChanges" Content="He revisado el alcance de los cambios" Margin="0,4,0,0" />
                            <Button x:Name="ApplyMirrorButton" Content="Aplicar _espejo revisado" Click="ApplyMirrorClick"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="ApplicationPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Aplicación y horarios" FontSize="22" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="Puedes usar la carpeta portable o preparar una copia estable para los horarios. Al actualizar, los trabajos habilitados usarán el nuevo ejecutor. Espera a que terminen los trabajadores y reintentos activos." TextWrapping="Wrap" Margin="0,8,0,12" />
                    <TextBlock x:Name="ApplicationReviewText" TextWrapping="Wrap" />
                    <CheckBox x:Name="AcceptApplicationUpdate" Content="He revisado los trabajos y quiero actualizar sus horarios propios" Checked="ApplicationChoiceChanged" Unchecked="ApplicationChoiceChanged" Margin="0,12,0,8" />
                    <Button x:Name="InstallApplicationButton" Content="Instalar o actualizar _ejecutor" Click="InstallApplicationClick" IsEnabled="False" HorizontalAlignment="Left" />
                    <TextBlock x:Name="InstalledApplicationText" TextWrapping="Wrap" Margin="0,8,0,12" />
                    <TextBlock Text="Para retirar la aplicación, quita primero sus horarios. Los trabajos quedarán deshabilitados y podrás seguir recuperando sus respaldos. Se conservan la configuración, el historial y los datos." TextWrapping="Wrap" />
                    <CheckBox x:Name="AcceptRemoveSchedules" Content="Deshabilitar todos los trabajos y retirar sus horarios propios" Checked="ApplicationChoiceChanged" Unchecked="ApplicationChoiceChanged" Margin="0,12,0,8" />
                    <Button x:Name="RemoveApplicationSchedulesButton" Content="Retirar todos los _horarios" Click="RemoveApplicationSchedulesClick" IsEnabled="False" HorizontalAlignment="Left" />
                    <Separator Margin="0,16,0,12" />
                    <TextBlock Text="Versiones instaladas" FontSize="18" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="Después de retirar los horarios y deshabilitar los trabajos puedes eliminar una versión instalada. Los respaldos y su configuración permanecen. Para borrar la versión abierta, usa otra copia portable de FolderTwin." TextWrapping="Wrap" Margin="0,8,0,8" />
                    <Button x:Name="ReviewInstalledVersionsButton" Content="Revisar versiones instaladas" Click="ReviewInstalledVersionsClick" HorizontalAlignment="Left" />
                    <ComboBox x:Name="InstalledVersionChoice" DisplayMemberPath="Label" ItemContainerStyle="{StaticResource NamedDateChoice}" SelectionChanged="InstalledVersionChanged" AutomationProperties.Name="Versión instalada que se quiere retirar" Margin="0,8,0,8" />
                    <TextBlock x:Name="InstalledVersionDetail" TextWrapping="Wrap" />
                    <CheckBox x:Name="AcceptInstalledVersionRemoval" Content="Eliminar únicamente la versión instalada seleccionada" Checked="ApplicationChoiceChanged" Unchecked="ApplicationChoiceChanged" Margin="0,8,0,8" />
                    <Button x:Name="RemoveInstalledVersionButton" Content="Eliminar versión revisada" Click="RemoveInstalledVersionClick" IsEnabled="False" HorizontalAlignment="Left" />
                    <Button Content="Volver a _trabajos" Click="ReturnFromApplicationClick" HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ImportPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Importar un trabajo" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Name="ImportSummaryText" TextWrapping="Wrap" Margin="0,8,0,12" />
                    <Button x:Name="ChooseImportDestinationButton" Content="Elegir respaldo _existente" Click="ChooseImportDestinationClick" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ImportDestinationText" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <WrapPanel>
                        <Button x:Name="ChooseImportSourceButton" Content="Elegir _origen para futuras copias" Click="ChooseImportSourceClick" Margin="0,0,8,4" />
                        <Button x:Name="ClearImportSourceButton" Content="Recuperar _sin origen" Click="ClearImportSourceClick" Margin="0,0,8,4" />
                    </WrapPanel>
                    <TextBlock x:Name="ImportSourceText" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <Button x:Name="ReviewImportButton" Content="_Comprobar identidades" Click="ReviewImportClick" IsEnabled="False" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ImportReviewText" TextWrapping="Wrap" Margin="0,8,0,8" />
                    <CheckBox x:Name="AcceptImport" Content="He revisado el modo y las carpetas del trabajo" Checked="ImportAcceptedChanged" Unchecked="ImportAcceptedChanged" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="SaveImportButton" Content="Guardar trabajo _deshabilitado" Click="SaveImportClick" IsEnabled="False" Margin="0,0,8,4" />
                        <Button Content="Volver a _trabajos" Click="CancelImportClick" Margin="0,0,8,4" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="RecoveryPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock Text="Recuperar archivos" FontSize="20" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Label Content="_Fecha del respaldo" Target="{Binding ElementName=RecoveryDates}" />
                    <ComboBox x:Name="RecoveryDates" DisplayMemberPath="Label" ItemContainerStyle="{StaticResource NamedDateChoice}" SelectionChanged="RecoveryDateChanged"
                              AutomationProperties.Name="Fecha del respaldo" />
                    <TextBlock x:Name="RecoverySummary" TextWrapping="Wrap" Margin="0,8,0,8" />
                    <TextBlock x:Name="RecoveryComparison" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="SearchRecoveryButton" DockPanel.Dock="Right" Content="_Buscar" Click="SearchRecoveryClick" Margin="8,0,0,0" />
                        <TextBox x:Name="RecoverySearch" MaxLength="256" KeyDown="RecoverySearchKeyDown"
                                 AutomationProperties.Name="Buscar por nombre o ruta en este respaldo" />
                    </DockPanel>
                    <CheckBox x:Name="RecoveryOnlyChanges" Content="Mostrar solo _cambios respecto al punto anterior"
                              Checked="RecoveryChangesClick" Unchecked="RecoveryChangesClick" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button x:Name="RecoveryParentButton" Content="Carpeta _superior" Click="RecoveryParentClick" Margin="0,0,8,4" />
                        <Button x:Name="OpenRecoveryFolderButton" Content="_Abrir carpeta" Click="OpenRecoveryFolderClick" IsEnabled="False" Margin="0,0,8,4" />
                    </WrapPanel>
                    <TextBlock x:Name="RecoveryPath" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ListBox x:Name="RecoveryFiles" MinHeight="160" MaxHeight="260"
                             AutomationProperties.Name="Carpetas y archivos recuperables"
                             SelectionChanged="RecoveryFileSelected" MouseDoubleClick="OpenRecoveryFolderClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding FullLabel}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullLabel}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,8,0,8">
                        <Button x:Name="PreviousRecoveryPageButton" Content="Página _anterior" Click="PreviousRecoveryPageClick" Margin="0,0,8,4" />
                        <Button x:Name="NextRecoveryPageButton" Content="Página s_iguiente" Click="NextRecoveryPageClick" Margin="0,0,8,4" />
                        <TextBlock x:Name="RecoveryPageText" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </WrapPanel>
                  </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="RestoreReviewText" TextWrapping="Wrap" />
                    </ScrollViewer>
                    <WrapPanel x:Name="RecoveryActions" Margin="0,4,0,0">
                        <Button x:Name="VerifyPointButton" Content="_Verificar respaldo" Click="VerifyPointClick" Margin="0,0,8,4" />
                        <Button x:Name="ReviewRestoreButton" Content="Recuperar _punto completo" Click="ReviewRestoreClick" Margin="0,0,8,4" />
                        <Button x:Name="ReviewFileRestoreButton" Content="Recuperar _archivo elegido" Click="ReviewFileRestoreClick" IsEnabled="False" Margin="0,0,8,4" />
                        <Button x:Name="RestorePointButton" Content="Recuperar en carpeta _nueva" Click="RestorePointClick"
                                IsEnabled="False" Margin="0,0,8,4" />
                        <Button x:Name="ReturnToJobsButton" Content="Volver a _trabajos" Click="ReturnToJobsClick" Margin="0,0,8,4" />
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <DockPanel x:Name="Wizard" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock x:Name="StepNumber" FontWeight="SemiBold" />
                    <TextBlock x:Name="StepTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.HeadingLevel="Level2" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button x:Name="BackStepButton" Content="_Atrás" Click="BackStepClick" TabIndex="3" Margin="0,0,8,4" />
                    <Button x:Name="NextStepButton" Content="_Siguiente" Click="NextStepClick" TabIndex="4" IsDefault="True" Margin="0,0,8,4" />
                    <Button x:Name="SaveJobButton" Content="_Guardar trabajo" Click="SaveJobClick" TabIndex="4" Visibility="Collapsed" Margin="0,0,8,4" />
                    <Button Content="_Cancelar" Click="CancelWizardClick" TabIndex="5" Margin="0,0,8,4" />
                </WrapPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel x:Name="OriginStep">
                            <TextBlock Text="Elige la carpeta que contiene los archivos que quieres respaldar." TextWrapping="Wrap" Margin="0,0,0,12" />
                            <Button x:Name="ChooseOriginButton" Content="Elegir _origen" Click="ChooseOriginClick" TabIndex="0" HorizontalAlignment="Left" />
                            <TextBlock x:Name="OriginText" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel x:Name="DestinationStep">
                            <TextBlock Text="Elige dónde crear la carpeta dedicada de este trabajo." TextWrapping="Wrap" Margin="0,0,0,12" />
                            <Button x:Name="ChooseParentButton" Content="Elegir _destino" Click="ChooseParentClick" TabIndex="0" HorizontalAlignment="Left" />
                            <TextBlock x:Name="ParentText" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel x:Name="OptionsStep" MaxWidth="540" HorizontalAlignment="Stretch">
                            <Label Content="_Nombre del trabajo" Target="{Binding ElementName=JobName}" />
                            <TextBox x:Name="JobName" MaxLength="100" TabIndex="0" Margin="0,0,0,8" AutomationProperties.Name="Nombre del trabajo" />
                            <Label Content="_Modo de respaldo" Target="{Binding ElementName=BackupMode}" />
                            <ComboBox x:Name="BackupMode" SelectedIndex="1" SelectionChanged="ModeChanged" TabIndex="1"
                                      AutomationProperties.Name="Modo de respaldo" Margin="0,0,0,4">
                                <ComboBoxItem Content="Copia acumulativa" />
                                <ComboBoxItem Content="Versionado" />
                                <ComboBoxItem Content="Espejo protegido" />
                            </ComboBox>
                            <TextBlock x:Name="ModeDetail" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Label Content="_Hora diaria (opcional)" Target="{Binding ElementName=DailyTime}" />
                            <TextBox x:Name="DailyTime" MaxLength="5" Width="92" TabIndex="2" HorizontalAlignment="Left"
                                     AutomationProperties.Name="Hora diaria en formato HH:mm" />
                            <TextBlock Text="Usa HH:mm o deja este campo vacío para ejecutar a demanda."
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel x:Name="ReviewStep">
                            <TextBlock x:Name="ReviewText" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="OperationStatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="RunProgress" Height="4" Margin="0,8,0,0" Visibility="Collapsed"
                             AutomationProperties.Name="Progreso de la operación activa" />
                <WrapPanel x:Name="RunControlsPanel" Visibility="Collapsed" Margin="0,8,0,0">
                    <Button x:Name="PauseRunButton" Content="_Pausar" Click="PauseRunClick" IsEnabled="False" Margin="0,0,8,4" />
                    <Button x:Name="CancelRunButton" Content="_Cancelar ejecución" Click="CancelRunClick" IsEnabled="False" Margin="0,0,8,4" />
                </WrapPanel>
                <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>
