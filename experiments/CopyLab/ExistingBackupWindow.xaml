<Window x:Class="CopyLab.ExistingBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CopyLab" local:RouteTheme.UsePalette="True"
        Title="FolderTwin · Abrir respaldo existente" Width="800" Height="680" MinWidth="580" MinHeight="480"
        WindowStartupLocation="CenterOwner" Language="es-CO" Icon="Assets/FolderTwin.ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ProductRoute.xaml" /></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <Button x:Name="BackButton" Content="← Volver a _trabajos" Click="BackClick" HorizontalAlignment="Left" />
            <TextBlock Text="Abrir respaldo existente" FontSize="24" FontWeight="SemiBold" Margin="0,14,0,10" />
            <Button x:Name="OpenButton" Content="_Elegir carpeta del respaldo" Click="OpenClick" HorizontalAlignment="Left"
                    ToolTip="Elige la carpeta FolderTwin del disco de respaldo. Permite recuperar sin el origen ni la configuración anterior." />
            <TextBlock x:Name="BackupPath" TextWrapping="Wrap" Margin="0,8" />
            <Label Content="_Fecha que quieres recuperar" Target="{Binding ElementName=Dates}" />
            <ComboBox x:Name="Dates" DisplayMemberPath="Label" SelectionChanged="DateChanged" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <WrapPanel>
                <Button x:Name="VerifyButton" Content="_Verificar fecha" Click="VerifyClick" Margin="0,0,8,6" IsEnabled="False" />
                <Button x:Name="RestoreAllButton" Content="_Recuperar toda la fecha" Click="RestoreAllClick" Margin="0,0,8,6" IsEnabled="False" />
                <Button x:Name="RestoreFileButton" Content="Recuperar _archivo seleccionado" Click="RestoreFileClick" Margin="0,0,8,6" IsEnabled="False" />
                <Button x:Name="CancelButton" Content="_Cancelar operación" Click="CancelClick" Visibility="Collapsed" />
            </WrapPanel>
            <ProgressBar x:Name="OperationProgress" Height="6" Visibility="Collapsed" />
            <TextBlock x:Name="OperationStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0" />
            <TextBlock x:Name="OutputPath" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <DockPanel Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Top">
                <WrapPanel>
                    <Button x:Name="ParentButton" Content="Carpeta _superior" Click="ParentClick" Margin="0,0,8,6" />
                    <TextBox x:Name="SearchBox" MinWidth="180" MaxLength="512" AutomationProperties.Name="Buscar archivo en el respaldo"
                             KeyDown="SearchKeyDown" Margin="0,0,8,6" />
                    <Button x:Name="SearchButton" Content="_Buscar" Click="SearchClick" Margin="0,0,8,6" />
                </WrapPanel>
                <TextBlock x:Name="FolderPath" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="PreviousButton" Content="Página a_nterior" Click="PreviousClick" Margin="0,0,8,0" />
                <Button x:Name="NextButton" Content="_Siguiente página" Click="NextClick" Margin="0,0,8,0" />
                <TextBlock x:Name="PageStatus" VerticalAlignment="Center" />
            </WrapPanel>
            <ListBox x:Name="Files" DisplayMemberPath="FullLabel" SelectionChanged="FileChanged" MouseDoubleClick="OpenFolder"
                     KeyDown="FilesKeyDown"
                     AutomationProperties.Name="Archivos y carpetas del punto seleccionado" />
        </DockPanel>
    </DockPanel>
</Window>
