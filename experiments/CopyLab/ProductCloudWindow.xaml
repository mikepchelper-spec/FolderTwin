<Window x:Class="CopyLab.ProductCloudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CopyLab" local:RouteTheme.UsePalette="True"
        Title="FolderTwin · Copia en nube" Width="620" Height="740" MinWidth="450" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Loaded="InitializeCloudHelp" PreviewKeyDown="CloudHelpKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ProductRoute.xaml" /></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="20" LastChildFill="True">
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="CloseCloudButton" Content="_Cerrar" IsCancel="True" Padding="12,4" />
            <Button x:Name="CloudHelpButton" Content="ⓘ _Ayuda" Click="CloudHelpClick" Margin="8,0,0,0" Padding="12,4" />
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Actions">
                <TextBlock x:Name="CloudHeading" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="ProviderHelp" Text="Vista previa para carpetas sintéticas. Usa un bucket privado y guarda la contraseña del repositorio fuera de este equipo." TextWrapping="Wrap" Margin="0,8" />
                <Border Style="{StaticResource RouteCard}" Margin="0,0,0,10">
                <StackPanel>
                <TextBlock Text="Ubicación de la copia" FontSize="16" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                <Label Content="_Proveedor" Target="{Binding ElementName=Provider}" />
                <ComboBox x:Name="Provider" SelectedIndex="0" SelectionChanged="ProviderChanged">
                    <ComboBoxItem Content="AWS S3" />
                    <ComboBoxItem Content="Backblaze B2 por S3" />
                    <ComboBoxItem Content="Endpoint S3 compatible" />
                    <ComboBoxItem Content="Filen · experimental" />
                    <ComboBoxItem Content="MEGA · experimental" />
                </ComboBox>
                <Label x:Name="RegionLabel" Content="_Región" Target="{Binding ElementName=Region}" />
                <TextBox x:Name="Region" MaxLength="64" Text="us-east-1" />
                <Label x:Name="EndpointLabel" Content="_Servidor S3 compatible" Target="{Binding ElementName=Endpoint}" />
                <TextBox x:Name="Endpoint" MaxLength="255" IsEnabled="False" />
                <Label x:Name="BucketLabel" Content="_Bucket" Target="{Binding ElementName=Bucket}" />
                <TextBox x:Name="Bucket" MaxLength="63" />
                <Label x:Name="PrefixLabel" Content="Carpeta del repositorio (opcional)" Target="{Binding ElementName=Prefix}" />
                <TextBox x:Name="Prefix" MaxLength="200" />
                </StackPanel>
                </Border>
                <Border Style="{StaticResource RouteCard}" Margin="0,0,0,10">
                <StackPanel>
                <TextBlock Text="Acceso al proveedor" FontSize="16" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Name="ProviderAccessHelp" TextWrapping="Wrap" Margin="0,6,0,4" />
                <Label x:Name="AccessKeyLabel" Content="_Identificador de acceso" Target="{Binding ElementName=AccessKey}" />
                <TextBox x:Name="AccessKey" MaxLength="1024" />
                <Label x:Name="SecretKeyLabel" Content="_Clave de acceso" Target="{Binding ElementName=SecretKey}" />
                <PasswordBox x:Name="SecretKey" MaxLength="2048" />
                <Label x:Name="SessionTokenLabel" Content="Token de sesión (opcional)" Target="{Binding ElementName=SessionToken}" />
                <PasswordBox x:Name="SessionToken" MaxLength="16384" />
                </StackPanel>
                </Border>
                <Border Style="{StaticResource RouteCard}" Margin="0,0,0,10">
                <StackPanel>
                <TextBlock Text="Clave para recuperar" FontSize="16" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="Esta contraseña abre tu respaldo cifrado. Guárdala junto a la ubicación del repositorio para poder recuperar desde otro equipo." TextWrapping="Wrap" Margin="0,6,0,4" />
                <Label Content="_Contraseña del repositorio" Target="{Binding ElementName=RepositoryPassword}" />
                <PasswordBox x:Name="RepositoryPassword" MaxLength="1024" PasswordChanged="RecoveryPasswordChanged" />
                <Expander x:Name="NewRepositoryReview" Header="Al crear un repositorio nuevo" IsExpanded="True" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Guarda la ubicación y la contraseña del repositorio fuera de este equipo. Las necesitarás para recuperar si pierdes tu perfil de Windows." TextWrapping="Wrap" />
                        <Label Content="Confirmar contraseña de _recuperación" Target="{Binding ElementName=ConfirmRepositoryPassword}" />
                        <PasswordBox x:Name="ConfirmRepositoryPassword" MaxLength="1024" PasswordChanged="RecoveryPasswordChanged" />
                        <CheckBox x:Name="RecoveryInformationSaved" Margin="0,8,0,0">
                            <TextBlock Text="He guardado la ubicación y la contraseña para recuperar desde otro equipo" TextWrapping="Wrap" />
                        </CheckBox>
                    </StackPanel>
                </Expander>
                </StackPanel>
                </Border>
                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="CreateCloud" Content="Crear y activar copia" Click="CreateClick" Margin="0,0,6,5" />
                    <Button x:Name="ConnectCloud" Content="Conectar y activar copia" Click="ConnectClick" Margin="0,0,6,5" />
                    <Button x:Name="ListCloud" Content="Consultar fechas de nube" Click="ListClick" Margin="0,0,6,5" />
                </WrapPanel>
                <TextBlock x:Name="CloudStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,8" />
                <TextBlock Text="Estado de los envíos" FontSize="16" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" Margin="0,8,0,4" />
                <Label Content="_Envío que quieres controlar" Target="{Binding ElementName=CloudTransfers}" />
                <ComboBox x:Name="CloudTransfers" DisplayMemberPath="Label" SelectionChanged="TransferSelected" />
                <WrapPanel Margin="0,4,0,4">
                    <Button x:Name="PreviousTransfers" Content="Envíos anteriores" Click="PreviousTransfersClick" IsEnabled="False" Margin="0,0,6,0" />
                    <Button x:Name="NextTransfers" Content="Envíos siguientes" Click="NextTransfersClick" IsEnabled="False" Margin="0,0,6,0" />
                    <TextBlock x:Name="TransferPage" VerticalAlignment="Center" />
                </WrapPanel>
                <WrapPanel Margin="0,4,0,8">
                    <Button x:Name="RefreshCloud" Content="Actualizar envíos" Click="RefreshClick" Margin="0,0,6,5" />
                    <Button x:Name="PauseCloudJob" Content="Pausar copia de este trabajo" Click="PauseCloudJobClick" IsEnabled="False" Margin="0,0,6,5" />
                    <Button x:Name="PauseCloud" Content="Pausar envío" Click="PauseClick" Margin="0,0,6,5" />
                    <Button x:Name="CancelCloud" Content="Cancelar envío" Click="CancelClick" Margin="0,0,6,5" />
                    <Button x:Name="RetryCloud" Content="Reintentar envío" Click="RetryClick" Margin="0,0,6,5" />
                </WrapPanel>
                <TextBlock Text="Recuperar desde la nube" FontSize="16" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" Margin="0,8,0,4" />
                <Label Content="_Fecha en nube" Target="{Binding ElementName=CloudDates}" />
                <ComboBox x:Name="CloudDates" DisplayMemberPath="Label" SelectionChanged="CloudDateChanged" />
                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="RestoreCloud" Content="Recuperar fecha _completa" Click="RestoreClick" IsEnabled="False" Margin="0,0,6,4" />
                    <Button x:Name="BrowseCloud" Content="_Elegir archivos o carpetas" Click="BrowseCloudClick" IsEnabled="False" Margin="0,0,6,4" />
                </WrapPanel>
                <TextBlock x:Name="CloudDateLimit" TextWrapping="Wrap" />
                <StackPanel x:Name="CloudCatalogPanel" Visibility="Collapsed" Margin="0,8,0,0">
                    <Label Content="_Buscar en la fecha" Target="{Binding ElementName=CloudFileSearch}" />
                    <DockPanel>
                        <Button x:Name="CloudSearchButton" DockPanel.Dock="Right" Content="_Buscar" Click="SearchCloudClick" Margin="6,0,0,0" />
                        <TextBox x:Name="CloudFileSearch" MaxLength="255" KeyDown="CloudSearchKeyDown" />
                    </DockPanel>
                    <TextBlock x:Name="CloudFolderPath" TextWrapping="Wrap" Margin="0,6,0,4" />
                    <ListBox x:Name="CloudFiles" DisplayMemberPath="FullLabel" Height="132" SelectionChanged="CloudFileChanged"
                             KeyDown="CloudFilesKeyDown" AutomationProperties.Name="Archivos y carpetas en la fecha remota" />
                    <WrapPanel Margin="0,6,0,4">
                        <Button x:Name="CloudParentFolder" Content="Subir un nivel" Click="CloudParentClick" Margin="0,0,6,4" />
                        <Button x:Name="CloudOpenFolder" Content="Entrar en carpeta" Click="CloudOpenClick" Margin="0,0,6,4" />
                        <Button x:Name="CloudPreviousFiles" Content="Página anterior" Click="CloudPreviousClick" Margin="0,0,6,4" />
                        <Button x:Name="CloudNextFiles" Content="Página siguiente" Click="CloudNextClick" Margin="0,0,6,4" />
                    </WrapPanel>
                    <TextBlock x:Name="CloudFilePage" />
                    <Button x:Name="RestoreCloudSelection" Content="Recuperar _selección" Click="RestoreCloudSelectionClick"
                            HorizontalAlignment="Left" Margin="0,6,0,4" />
                </StackPanel>
                <TextBlock Text="Intentos de recuperación" FontSize="16" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level2" Margin="0,12,0,4" />
                <ComboBox x:Name="CloudRecoveryRuns" DisplayMemberPath="Label" SelectionChanged="CloudRunChanged"
                          AutomationProperties.Name="Intento de recuperación remota" />
                <WrapPanel Margin="0,6,0,4">
                    <Button x:Name="OlderCloudRuns" Content="Intentos anteriores" Click="OlderCloudRunsClick" Margin="0,0,6,4" />
                    <Button x:Name="NewerCloudRuns" Content="Intentos recientes" Click="NewerCloudRunsClick" Margin="0,0,6,4" />
                    <Button x:Name="CancelCloudRecovery" Content="Cancelar recuperación" Click="CancelCloudRecoveryClick" Margin="0,0,6,4" />
                </WrapPanel>
                <TextBlock x:Name="CloudRecoveryStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="CloudRecoveryProgress" Visibility="Collapsed" Height="5" Margin="0,6"
                             AutomationProperties.Name="Progreso de recuperación remota" />
                <TextBox x:Name="CloudRecoveryOutput" IsReadOnly="True" TextWrapping="Wrap" Visibility="Collapsed"
                         AutomationProperties.Name="Carpeta de salida de la recuperación" Margin="0,6,0,4" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
