<Window x:Class="CopyLab.ProductCloudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderTwin · Copia en nube" Width="620" Height="740" MinWidth="450" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20" LastChildFill="True">
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="_Cerrar" IsCancel="True" Padding="12,4" />
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Actions">
                <TextBlock x:Name="CloudHeading" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="ProviderHelp" Text="Vista previa para carpetas sintéticas. Usa un bucket privado y guarda la contraseña del repositorio fuera de este equipo." TextWrapping="Wrap" Margin="0,8" />
                <Label Content="_Proveedor" Target="{Binding ElementName=Provider}" />
                <ComboBox x:Name="Provider" SelectedIndex="0" SelectionChanged="ProviderChanged">
                    <ComboBoxItem Content="AWS S3" />
                    <ComboBoxItem Content="Backblaze B2 por S3" />
                    <ComboBoxItem Content="Endpoint S3 compatible" />
                    <ComboBoxItem Content="Filen · experimental" />
                    <ComboBoxItem Content="MEGA · experimental" />
                </ComboBox>
                <Label x:Name="RegionLabel" Content="_Región" Target="{Binding ElementName=Region}" />
                <TextBox x:Name="Region" MaxLength="64" Text="us-east-1" />
                <Label x:Name="EndpointLabel" Content="_Servidor S3 compatible" Target="{Binding ElementName=Endpoint}" />
                <TextBox x:Name="Endpoint" MaxLength="255" IsEnabled="False" />
                <Label x:Name="BucketLabel" Content="_Bucket" Target="{Binding ElementName=Bucket}" />
                <TextBox x:Name="Bucket" MaxLength="63" />
                <Label x:Name="PrefixLabel" Content="Carpeta del repositorio (opcional)" Target="{Binding ElementName=Prefix}" />
                <TextBox x:Name="Prefix" MaxLength="200" />
                <Label x:Name="AccessKeyLabel" Content="_Identificador de acceso" Target="{Binding ElementName=AccessKey}" />
                <TextBox x:Name="AccessKey" MaxLength="1024" />
                <Label x:Name="SecretKeyLabel" Content="_Clave de acceso" Target="{Binding ElementName=SecretKey}" />
                <PasswordBox x:Name="SecretKey" MaxLength="2048" />
                <Label x:Name="SessionTokenLabel" Content="Token de sesión (opcional)" Target="{Binding ElementName=SessionToken}" />
                <PasswordBox x:Name="SessionToken" MaxLength="16384" />
                <Label Content="_Contraseña del repositorio" Target="{Binding ElementName=RepositoryPassword}" />
                <PasswordBox x:Name="RepositoryPassword" MaxLength="1024" />
                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="CreateCloud" Content="Crear y activar copia" Click="CreateClick" Margin="0,0,6,5" />
                    <Button x:Name="ConnectCloud" Content="Conectar y activar copia" Click="ConnectClick" Margin="0,0,6,5" />
                    <Button x:Name="ListCloud" Content="Consultar fechas de nube" Click="ListClick" Margin="0,0,6,5" />
                </WrapPanel>
                <TextBlock x:Name="CloudStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,8" />
                <WrapPanel Margin="0,4,0,8">
                    <Button x:Name="RefreshCloud" Content="Actualizar envíos" Click="RefreshClick" Margin="0,0,6,5" />
                    <Button x:Name="PauseCloudJob" Content="Pausar copia de este trabajo" Click="PauseCloudJobClick" IsEnabled="False" Margin="0,0,6,5" />
                    <Button x:Name="PauseCloud" Content="Pausar envío" Click="PauseClick" Margin="0,0,6,5" />
                    <Button x:Name="CancelCloud" Content="Cancelar envío" Click="CancelClick" Margin="0,0,6,5" />
                    <Button x:Name="RetryCloud" Content="Reintentar envío" Click="RetryClick" Margin="0,0,6,5" />
                </WrapPanel>
                <Label Content="_Fecha en nube" Target="{Binding ElementName=CloudDates}" />
                <ComboBox x:Name="CloudDates" DisplayMemberPath="Label" />
                <Button x:Name="RestoreCloud" Content="Recuperar en carpeta _nueva" HorizontalAlignment="Left" Click="RestoreClick" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
