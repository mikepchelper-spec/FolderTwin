<Window x:Class="CopyLab.VersionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderTwin · Versiones" Width="860" Height="740" MinWidth="620" MinHeight="450"
        WindowStartupLocation="CenterOwner" Language="es-CO">
    <DockPanel Margin="24">
        <ScrollViewer DockPanel.Dock="Top" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="Versiones" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Elige un almacén del espacio de pruebas. Cada fecha confirmada puede restaurarse por separado."
                       TextWrapping="Wrap" Margin="0,4,0,12" />
            <WrapPanel>
                <Button x:Name="NewStoreButton" Content="_Crear almacén" Click="CreateStoreClick" Margin="0,0,8,6" />
                <Button x:Name="OpenStoreButton" Content="_Abrir almacén" Click="OpenStoreClick" Margin="0,0,8,6" />
                <Button x:Name="ChooseSourceButton" Content="Elegir _origen" Click="ChooseSourceClick" Margin="0,0,8,6" />
                <Button x:Name="CreatePointButton" Content="Crear _punto" Click="CreatePointClick" Margin="0,0,8,6" />
                <Button x:Name="BackgroundButton" Content="Copiar en segundo plano" Click="BackgroundClick" Margin="0,0,8,6" />
                <Button x:Name="RefreshButton" Content="Act_ualizar" Click="RefreshClick" Margin="0,0,8,6" />
            </WrapPanel>
            <TextBlock x:Name="StoreText" Text="Elige un almacén para empezar." TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBlock x:Name="SourceText" TextWrapping="Wrap" Margin="0,2,0,10" />
            <ComboBox x:Name="JobChoice" DisplayMemberPath="Source" SelectionChanged="JobChoiceChanged" Margin="0,0,0,8"
                      AutomationProperties.Name="Trabajo guardado de este almacén" />
            <Expander Header="Horario y bandeja" Margin="0,0,0,8">
            <StackPanel>
            <WrapPanel Margin="0,6,0,8">
                <TextBlock Text="Hora diaria de este equipo" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="ScheduleTime" Text="20:00" Width="65" Margin="0,0,8,0"
                         AutomationProperties.Name="Hora diaria en formato HH:mm" />
                <Button x:Name="ScheduleButton" Content="Programar" Click="ScheduleClick" Margin="0,0,8,0" />
                <Button x:Name="RemoveScheduleButton" Content="Quitar horario" Click="RemoveScheduleClick" />
            </WrapPanel>
            <TextBlock x:Name="ScheduleText" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="El horario se ejecuta mientras tengas la sesión iniciada." />
            <WrapPanel Margin="0,0,0,8">
                <CheckBox x:Name="TrayAtLogin" Content="Mostrar estado al iniciar sesión" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button x:Name="ApplyStartupButton" Content="Aplicar inicio" Click="StartupClick" />
            </WrapPanel>
            </StackPanel>
            </Expander>
            <Expander Header="Retención y cuarentena" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="La limpieza es manual. Revisa qué fechas expirarán; la cuarentena no libera espacio." TextWrapping="Wrap" Margin="0,6,0,6" />
                    <WrapPanel>
                        <TextBlock Text="Días" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="RetentionDays" Text="30" Width="45" AutomationProperties.Name="Días de retención diaria" Margin="0,0,8,0" />
                        <TextBlock Text="Semanas" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="RetentionWeeks" Text="8" Width="45" AutomationProperties.Name="Semanas de retención semanal" Margin="0,0,8,0" />
                        <TextBlock Text="Meses" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="RetentionMonths" Text="12" Width="45" AutomationProperties.Name="Meses de retención mensual" Margin="0,0,8,0" />
                        <TextBlock Text="Gracia (días)" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="RetentionGrace" Text="7" Width="45" AutomationProperties.Name="Días de gracia antes de purgar" Margin="0,0,8,0" />
                        <Button x:Name="PreviewRetentionButton" Content="Revisar retención" Click="PreviewRetentionClick" />
                    </WrapPanel>
                    <TextBlock x:Name="RetentionText" TextWrapping="Wrap" Margin="0,6,0,6" />
                    <CheckBox x:Name="AcceptRetention" Content="He revisado las fechas que expirarán" Checked="RetentionChoiceChanged" Unchecked="RetentionChoiceChanged" Margin="0,0,0,6" />
                    <Button x:Name="ApplyRetentionButton" Content="Mover a cuarentena" Click="ApplyRetentionClick" HorizontalAlignment="Left" Margin="0,0,0,6" />
                    <ComboBox x:Name="RetentionChoice" DisplayMemberPath="Label" SelectionChanged="RetentionChoiceChanged" AutomationProperties.Name="Operaciones de cuarentena" Margin="0,0,0,6" />
                    <WrapPanel>
                        <Button x:Name="ResumeRetentionButton" Content="Reanudar movimientos" Click="ResumeRetentionClick" Margin="0,0,8,6" />
                        <Button x:Name="UndoRetentionButton" Content="Deshacer cuarentena" Click="UndoRetentionClick" Margin="0,0,8,6" />
                    </WrapPanel>
                    <CheckBox x:Name="AcceptPurge" Content="Entiendo que la purga borra datos y no se puede deshacer" Checked="RetentionChoiceChanged" Unchecked="RetentionChoiceChanged" Margin="0,0,0,6" />
                    <Button x:Name="PurgeRetentionButton" Content="Purgar tras el plazo de gracia" Click="PurgeRetentionClick" HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>
            <Expander Header="Espejo protegido" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="El espejo refleja el origen en una carpeta navegable. Los puntos anteriores se recuperan desde Versiones." TextWrapping="Wrap" Margin="0,6,0,6" />
                    <WrapPanel>
                        <Button x:Name="CreateMirrorButton" Content="Preparar espejo" Click="CreateMirrorClick" Margin="0,0,8,6" />
                        <TextBlock Text="Umbral de cambios (%)" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox x:Name="MirrorThreshold" Text="25" Width="48" Margin="0,0,8,6" TextChanged="MirrorChoiceChanged" AutomationProperties.Name="Porcentaje de cambios que exige revisión adicional" />
                        <Button x:Name="ReviewMirrorButton" Content="Revisar espejo" Click="ReviewMirrorClick" Margin="0,0,8,6" />
                        <Button x:Name="OpenMirrorFolderButton" Content="Ver carpeta actual" Click="OpenMirrorFolderClick" Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock x:Name="MirrorText" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite" />
                    <CheckBox x:Name="AcceptMirror" Content="Revisé las altas, reemplazos y retiradas" Checked="MirrorChoiceChanged" Unchecked="MirrorChoiceChanged" />
                    <CheckBox x:Name="AcceptEmptyMirror" Content="Confirmo que el origen está vacío y debe reflejarse así" Checked="MirrorChoiceChanged" Unchecked="MirrorChoiceChanged" />
                    <CheckBox x:Name="AcceptMassMirror" Content="Revisé el alcance de los cambios masivos" Checked="MirrorChoiceChanged" Unchecked="MirrorChoiceChanged" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="ApplyMirrorButton" Content="Actualizar espejo" Click="ApplyMirrorClick" Margin="0,0,8,0" />
                        <Button x:Name="ResumeMirrorButton" Content="Reanudar espejo" Click="ResumeMirrorClick" />
                    </WrapPanel>
                </StackPanel>
            </Expander>
            <TextBlock x:Name="JobsText" TextWrapping="Wrap" Margin="0,0,0,10" />
        </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,10,0,0"
                   AutomationProperties.LiveSetting="Polite" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" Text="Puntos de recuperación" FontWeight="SemiBold" Margin="0,0,0,4" />
                <Button x:Name="ResumeButton" DockPanel.Dock="Bottom" Content="_Reintentar punto" Click="ResumeClick"
                        HorizontalAlignment="Left" Margin="0,6,0,0" />
                <ListBox x:Name="Timeline" DisplayMemberPath="Label" SelectionChanged="TimelineChanged"
                         AutomationProperties.Name="Puntos de recuperación" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
            <DockPanel Grid.Column="1">
                <StackPanel DockPanel.Dock="Top">
                    <CheckBox x:Name="OnlyChanges" Content="Mostrar cambios respecto al punto anterior"
                              Checked="FilterChanged" Unchecked="FilterChanged" Margin="0,0,0,4" />
                    <TextBlock x:Name="ComparisonText" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,5,0,5">
                        <Button x:Name="ParentButton" Content="_Subir" Click="ParentClick" Margin="0,0,8,0" />
                        <Button x:Name="OpenDirectoryButton" Content="_Entrar en carpeta" Click="OpenDirectoryClick" />
                    </WrapPanel>
                    <TextBlock x:Name="DirectoryText" TextWrapping="Wrap" Margin="0,0,0,4" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button x:Name="VerifyButton" Content="_Verificar punto" Click="VerifyClick" Margin="0,0,8,4" />
                    <Button x:Name="RestorePointButton" Content="Restaurar _punto" Click="RestorePointClick" Margin="0,0,8,4" />
                    <Button x:Name="RestoreFileButton" Content="Restaurar _archivo" Click="RestoreFileClick" Margin="0,0,8,4" />
                </WrapPanel>
                <ListBox x:Name="Files" DisplayMemberPath="Label" SelectionChanged="FilesChanged"
                         AutomationProperties.Name="Archivos y carpetas del punto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
