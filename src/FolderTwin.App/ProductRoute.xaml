<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="RouteCanvas" Color="#EAF1EE" />
    <SolidColorBrush x:Key="RoutePaper" Color="#F9FCF9" />
    <SolidColorBrush x:Key="RouteInk" Color="#142B27" />
    <SolidColorBrush x:Key="RouteMuted" Color="#48615A" />
    <SolidColorBrush x:Key="RouteRule" Color="#C5D6CE" />
    <SolidColorBrush x:Key="RouteAccent" Color="#12634F" />
    <SolidColorBrush x:Key="RouteAccentHover" Color="#0B513F" />
    <SolidColorBrush x:Key="RouteSoft" Color="#DCECE4" />
    <SolidColorBrush x:Key="RouteRail" Color="#E3ECE6" />
    <SolidColorBrush x:Key="RouteWarning" Color="#774715" />
    <SolidColorBrush x:Key="RouteWarningFill" Color="#FAEBCE" />
    <SolidColorBrush x:Key="RouteOnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RouteSelectedFill" Color="#DCECE4" />
    <SolidColorBrush x:Key="RouteSelectedInk" Color="#142B27" />
    <SolidColorBrush x:Key="RouteDisabledInk" Color="#48615A" />
    <sys:Double x:Key="RouteDisabledOpacity">0.53</sys:Double>
    <DrawingBrush x:Key="RouteMap" TileMode="Tile" Viewport="0,0,15,15" ViewportUnits="Absolute"
                  Viewbox="0,0,15,15" ViewboxUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{DynamicResource RouteSoft}" Geometry="M0,0 H15 V15 H0 Z" />
                <GeometryDrawing Brush="{DynamicResource RouteRule}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="7.5,7.5" RadiusX="1" RadiusY="1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <Style x:Key="RouteCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource RoutePaper}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RouteRule}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="RouteLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource RouteMuted}" />
    </Style>
    <Style x:Key="RouteIcon" TargetType="Border">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Background" Value="{DynamicResource RouteSoft}" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="RoutePill" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource RoutePaper}" />
        <Setter Property="Foreground" Value="{DynamicResource RouteInk}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RouteRule}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="13,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pill" CornerRadius="20" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource RouteAccent}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="BorderThickness" Value="2" /><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource RouteAccent}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pill" Property="Opacity" Value=".8" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource RouteDisabledInk}" />
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource RouteDisabledInk}" />
                            <Setter TargetName="Pill" Property="Opacity" Value="{DynamicResource RouteDisabledOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RoutePrimary" TargetType="Button" BasedOn="{StaticResource RoutePill}">
        <Setter Property="Background" Value="{DynamicResource RouteAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RouteAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource RouteOnAccent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource RouteAccentHover}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource RouteAccentHover}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="RouteBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource RouteSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource RouteAccent}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,3" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Attention">
                <Setter Property="Background" Value="{DynamicResource RouteWarningFill}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource RouteWarning}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="RouteJob" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding Detail}" />
        <Setter Property="Foreground" Value="{DynamicResource RouteInk}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Job" CornerRadius="14" Background="{DynamicResource RoutePaper}"
                            BorderBrush="{DynamicResource RouteRule}" BorderThickness="1" Padding="9,6">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Job" Property="Background" Value="{DynamicResource RouteSoft}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Job" Property="Background" Value="{DynamicResource RouteSelectedFill}" />
                            <Setter Property="Foreground" Value="{DynamicResource RouteSelectedInk}" />
                            <Setter TargetName="Job" Property="BorderBrush" Value="{DynamicResource RouteAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Job" Property="BorderThickness" Value="2" /><Setter TargetName="Job" Property="BorderBrush" Value="{DynamicResource RouteAccent}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource RoutePill}" />
</ResourceDictionary>
